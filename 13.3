nama_file = input("Enter a file name: ")
try:
    with open(nama_file, 'r') as file:
        counts = {}
        for line in file:
            if line.startswith('From '):
                words = line.split()
                waktu = words[5]
                jam = waktu.split(':')[0]
                counts[jam] = counts.get(jam, 0) + 1
        for jam in sorted(counts):
            print(jam, counts[jam])
except:
    print("File tidak ditemukan.")
